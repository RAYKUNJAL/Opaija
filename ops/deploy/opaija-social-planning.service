[Unit]
Description=OPAIJA social slot planning (no platform publishing adapter connected)
After=opaija.service
[Service]
Type=oneshot
WorkingDirectory=/var/www/opaija
EnvironmentFile=/var/www/opaija/.env
ExecStart=/usr/bin/node /var/www/opaija/dist-server/production/scheduler.js
User=www-data
Group=www-data
