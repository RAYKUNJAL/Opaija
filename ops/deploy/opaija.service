[Unit]
Description=Opaija website and API
After=network.target

[Service]
Type=simple
WorkingDirectory=/var/www/opaija
Environment=NODE_ENV=production
Environment=PORT=8787
ExecStart=/usr/bin/node /var/www/opaija/dist-server/index.js
Restart=always
RestartSec=5
User=www-data
Group=www-data

[Install]
WantedBy=multi-user.target
