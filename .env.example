# === COST CONTROL === see memory/cost-rules.md
# Default cost mode for the pipeline. Auto-resolved from runtime if unset:
#   <=90s  -> lean    (Seedance Lite, Haiku canon-check)
#   <=600s -> balanced (Pro for first/last beat, Lite middle)
#   >600s  -> quality  (Pro everywhere)
COST_MODE=
# Set to 1 to keep public/episodes/<EPxxx>/clips/ after a successful render.
KEEP_INTERMEDIATES=
# Hard rework caps — fail a beat if it's been re-attempted more than (cap * expected) times.
REWORK_CAP_VERTICAL=1.5
REWORK_CAP_EPISODE=1.8
REWORK_CAP_MOVIE=2.0
# Monthly budget alarm in USD. produce.ts pre-flight aborts if month-to-date >= this.
# Pass --ignore-budget to override for a single run.
MONTHLY_BUDGET_USD=500
# Yellow warning starts at this percentage of MONTHLY_BUDGET_USD (default 75 -> warn at $375).
BUDGET_WARN_PCT=75
# Override the Haiku model used for canon-check (default: claude-3-5-haiku-latest)
CLAUDE_CANON_MODEL=

# Web/API ports
PORT=8787
VITE_API_BASE_URL=http://localhost:8787

# Video provider options: mock, fal, byteplus
VIDEO_PROVIDER=mock

# OpenAI brain/image/script layer. Keep server-side only.
# Optional — only needed if not using ElevenLabs alignment for captions
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Whisper model for caption fallback (defaults to whisper-1)
# WHISPER_MODEL=whisper-1

# Anthropic brain/script layer. Default brain per CLAUDE.md. Keep server-side only.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# Brain provider options: openai, openrouter
BRAIN_PROVIDER=openai
OPENROUTER_API_KEY=
OPENROUTER_MODEL=moonshotai/kimi-k2
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://opaija.com
OPENROUTER_APP_NAME=Opaija Command Center

# fal.ai Seedance 2.0 route
# Get from https://fal.ai/dashboard/keys and keep server-side only.
FAL_KEY=
SEEDANCE_DEFAULT_MODEL=bytedance/seedance-2.0/fast/image-to-video

# BytePlus / ModelArk route, kept as a future adapter because availability and endpoint access vary by region/account.
ARK_API_KEY=
BYTEPLUS_MODELARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3

# Voice provider options: mock, elevenlabs, openai
VOICE_PROVIDER=mock
ELEVENLABS_API_KEY=
ELEVENLABS_NARRATOR_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

# Merch provider options: mock, printful, printify
MERCH_PROVIDER=mock
PRINTFUL_API_KEY=
PRINTFUL_STORE_ID=
PRINTIFY_API_KEY=
PRINTIFY_SHOP_ID=

# Growth/ad/email provider variables. Store secrets only in .env or server secrets.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PIXEL_ID=
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=
MAILCHIMP_AUDIENCE_ID=

# === PUBLISHING ===
# Auto-upload finished MP4s to YouTube Shorts, TikTok, and Instagram Reels.
# All adapters fall back to MOCK MODE if their credentials are missing —
# the pipeline runs end-to-end without these set.
# TODO: Set up OAuth via scripts/setup-publish.js (not yet built).

# YouTube Data API v3 — OAuth2 refresh-token flow.
# Create a Google Cloud project, enable YouTube Data API v3, create OAuth client,
# then run the (TODO) setup script to mint a refresh token with youtube.upload scope.
# YOUTUBE_CLIENT_ID and YOUTUBE_CLIENT_SECRET are also declared above for growth ads — same values are reused here.
YOUTUBE_REFRESH_TOKEN=
PUBLISH_PRIVACY_YT=private

# TikTok Content Posting API — requires Direct Post permission (apply via TikTok Developer Portal).
# TIKTOK_ACCESS_TOKEN is also declared above for ads — same value reused if scoped for posting.
TIKTOK_CLIENT_KEY=
TIKTOK_OPEN_ID=

# Instagram Graph API — requires a Business or Creator account linked to a Facebook Page.
# NOTE: Instagram requires a publicly accessible HTTPS video URL — host the MP4 on R2/S3/Cloudinary
# or use a tunnel like ngrok/cloudflared for local testing.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ID=

# Resend founder-list sync and welcome email
RESEND_API_KEY=
RESEND_SEGMENT_ID=
RESEND_AUDIENCE_ID=
RESEND_FROM_EMAIL=Opaija <founders@opaija.com>
PUBLIC_SITE_URL=https://opaija.com
