# Web/API ports
PORT=8787
VITE_API_BASE_URL=http://localhost:8787
BOOK_BUILDER_DATA_DIR=data/book-builder
BOOK_BUILDER_FORCE_MOCK=0

# Command Center access. Use long, unique values in production.
ADMIN_PASSWORD=
SESSION_SECRET=

# Video provider options: mock, fal, byteplus
VIDEO_PROVIDER=mock

# OpenAI brain/image/script layer. Keep server-side only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5
REPLICATE_API_TOKEN=
# Art model overrides for panel image generation.
# Defaults: 1/no reference -> black-forest-labs/flux-kontext-pro, multi-ref -> black-forest-labs/flux-2-pro
REPLICATE_IMAGE_MODEL_ONE_REFERENCE=black-forest-labs/flux-kontext-pro
REPLICATE_IMAGE_MODEL_MULTI_REFERENCE=black-forest-labs/flux-2-pro
REPLICATE_IMAGE_MODEL_NO_REFERENCE=black-forest-labs/flux-kontext-pro

# Brain provider options: openai, openrouter
BRAIN_PROVIDER=openai
OPENROUTER_API_KEY=
OPENROUTER_MODEL=moonshotai/kimi-k2
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://opaija.com
OPENROUTER_APP_NAME=Opaija Command Center

# fal.ai Seedance 2.0 route
# Get from https://fal.ai/dashboard/keys and keep server-side only.
FAL_KEY=
SEEDANCE_DEFAULT_MODEL=bytedance/seedance-2.0/fast/image-to-video

# BytePlus / ModelArk route, kept as a future adapter because availability and endpoint access vary by region/account.
ARK_API_KEY=
BYTEPLUS_MODELARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3

# Voice provider options: mock, elevenlabs, openai
VOICE_PROVIDER=mock
ELEVENLABS_API_KEY=
ELEVENLABS_NARRATOR_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

# Merch provider options: mock, printful, printify
MERCH_PROVIDER=mock
PRINTFUL_API_KEY=
PRINTFUL_STORE_ID=
PRINTIFY_API_KEY=
PRINTIFY_SHOP_ID=

# Growth/ad/email provider variables. Store secrets only in .env or server secrets.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PIXEL_ID=
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=
MAILCHIMP_AUDIENCE_ID=

# Resend founder-list sync and welcome email
RESEND_API_KEY=
RESEND_SEGMENT_ID=
RESEND_AUDIENCE_ID=
RESEND_FROM_EMAIL=Opaija <founders@opaija.com>
PUBLIC_SITE_URL=https://opaija.com

# PayPal checkout
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Launch safety and scheduling
NODE_ENV=development
ALLOWED_ORIGINS=https://opaija.com,https://www.opaija.com,http://localhost:5173
BLOG_TIMEZONE=America/Port_of_Spain
